PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Configure only when running behind a trusted reverse proxy.
TRUST_PROXY_HOPS=0
PYTHON_BIN=python

# Firebase Realtime Database (leave empty to use the in-memory fallback)
FIREBASE_DATABASE_URL=
# service-account JSON as one-line base64:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Google Cloud OAuth Web client ID. No client secret is needed for GIS ID tokens.
GOOGLE_CLIENT_ID=
# Gmail SMTP requires an App Password (not your Google account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# LOCAL DEVELOPMENT ONLY. Creates accounts once, never overwrites existing users.
SEED_TEST_USERS=0
TEST_ADMIN_EMAIL=admin@example.test
TEST_ADMIN_PASSWORD=
TEST_USER_EMAIL=user@example.test
TEST_USER_PASSWORD=
