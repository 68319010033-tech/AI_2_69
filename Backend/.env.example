PORT=3000
ADMIN_USER=judge
ADMIN_PASS=change-me
# AUTH_DISABLED=1   # only for local development
PYTHON_BIN=python

# Firebase Realtime Database (leave empty to use the in-memory fallback)
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app
# service-account JSON as one-line base64:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=

GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
